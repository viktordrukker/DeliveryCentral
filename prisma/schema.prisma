  WorkEvidence              WorkEvidence[]
  Client                    Client[]
  InAppNotification         InAppNotification[]
  LeaveRequest              LeaveRequest[]
  Skill                     Skill[]
  TimesheetWeek             TimesheetWeek[]
  Vendor                    Vendor[]
  // Sprint 2 / S2-1 — lean staffing aggregate.
  ProjectPosition           ProjectPosition[]           @relation("ProjectPositionTenant")
  // LEAN-P4a-1 — Distribution Studio scenario tenancy.
  PlannerScenario           PlannerScenario[]           @relation("PlannerScenarioTenant")

  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("Tenant")
}

/// Sprint 2 / S2-1 — lean staffing aggregate.
///
/// ProjectPosition is the canonical "position on a project". It collapses
/// the legacy three-model pattern (StaffingRequest = demand,
/// ProjectAssignment = supply, AssignmentProposalSlate = proposed match)
/// into a single aggregate where `fillStatus` carries the full lifecycle.
///
/// Expand-phase model (Sprint 2). Backfilled from existing data in S2-5.
/// Dual-write enabled in S2-6. Legacy models dropped in Sprint 5 contract.
///
/// See docs/planning/claude-design/lean-simplification-initiative.md §2.
model ProjectPosition {
  id                           String                       @id @default(uuid()) @db.Uuid
  publicId                     String?                      @unique @db.VarChar(32)
  projectId                    String                       @db.Uuid
  workstreamId                 String?                      @db.Uuid
  // Demand definition (was: StaffingRequest fields).
  role                         String
  skills                       String[]                     @default([])
  summary                      String?
  requiredAllocationPercent    Decimal                      @db.Decimal(5, 2)
  startDate                    DateTime                     @db.Date
  endDate                      DateTime                     @db.Date
  priority                     StaffingRequestPriority      @default(MEDIUM)
  requestedByPersonId          String?                      @db.Uuid
  // Active fill (was: the row in ProjectAssignment with status in BOOKED/ONBOARDING/ASSIGNED/ON_HOLD).
  fillStatus                   ProjectPositionFillStatus    @default(DRAFT)
  activePersonId               String?                      @db.Uuid
  activeAllocationPercent      Decimal?                     @db.Decimal(5, 2)
  activeValidFrom              DateTime?                    @db.Timestamptz(3)
  activeValidTo                DateTime?                    @db.Timestamptz(3)
  onboardingDate               DateTime?                    @db.Timestamptz(3)
  // LEAN-P4c-1 — onboarding-stage approval gate. When `requiresOnboardingApproval`
  // is TRUE, the paired ProjectAssignment cannot transition ONBOARDING → ASSIGNED
  // until `onboardingApprovedAt` is populated (set by `ApproveOnboardingService`).
  // PM-only approval; defaults to FALSE so positions without a gate keep the
  // existing direct-to-ASSIGNED behaviour.
  requiresOnboardingApproval   Boolean                      @default(false)
  onboardingApprovedAt         DateTime?                    @db.Timestamptz(3)
  onboardingApprovedByPersonId String?                      @db.Uuid
  notes                        String?
  // SLA tracking (was: ProjectAssignment SLA fields).
  requiresDirectorApproval     Boolean                      @default(false)
  slaStage                     AssignmentSlaStage?
  slaDueAt                     DateTime?                    @db.Timestamptz(3)
  slaBreachedAt                DateTime?                    @db.Timestamptz(3)
  slaWarnedAt50pct             DateTime?                    @db.Timestamptz(3)
  slaWarnedAt75pct             DateTime?                    @db.Timestamptz(3)
  // Billing rate pinning (was: ProjectAssignment rate fields).
  appliedRateCardEntryId       String?                      @db.Uuid
  appliedRateCardEntry         RateCardEntry?               @relation("ProjectPositionRateCardEntry", fields: [appliedRateCardEntryId], references: [id], onDelete: SetNull)
  effectiveBillRate            Decimal?                     @db.Decimal(10, 2)
  effectiveBillCurrency        String?                      @db.VarChar(3)
  // Reason text preserved across transitions.
  rejectionReason              String?
  rejectionReasonCode          String?
  cancellationReason           String?
  onHoldReason                 String?
  onHoldCaseId                 String?                      @db.Uuid
  releaseReason                String?
  // Concurrency + audit.
  version                      Int                          @default(1)
  createdAt                    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                     @updatedAt @db.Timestamptz(3)
  createdByPersonId            String?                      @db.Uuid
  updatedByPersonId            String?                      @db.Uuid
  archivedAt                   DateTime?                    @db.Timestamptz(3)
  // SoT PR 16b — historical provenance pointers retained after the legacy
  // ProjectAssignment / StaffingRequest tables were dropped. No @relation
  // because the source tables no longer exist; these are soft pointers
  // used by staffing-desk / planner read paths to thread historical
  // aggregate ids through the read model.
  legacyAssignmentId           String?                      @db.Uuid
  legacyStaffingRequestId      String?                      @db.Uuid
  // Tenant.
  tenantId                     String?                      @db.Uuid
  Tenant                       Tenant?                      @relation("ProjectPositionTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  // Relations.
  project                      Project                      @relation("ProjectPositions", fields: [projectId], references: [id], onDelete: Restrict)
  activePerson                 Person?                      @relation("ProjectPositionActivePerson", fields: [activePersonId], references: [id], onDelete: SetNull)
  requestedByPerson            Person?                      @relation("ProjectPositionRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: SetNull)
  createdByPerson              Person?                      @relation("ProjectPositionCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson              Person?                      @relation("ProjectPositionUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  onboardingApprovedByPerson   Person?                      @relation("ProjectPositionOnboardingApprovedBy", fields: [onboardingApprovedByPersonId], references: [id], onDelete: SetNull)
  candidates                   ProjectPositionCandidate[]
  fillHistory                  ProjectPositionFillHistory[]
  // LEAN-P0-5 — back-relation for TimesheetEntry.positionId.
  timesheetEntries             TimesheetEntry[]             @relation("TimesheetEntryPosition")

  @@index([projectId, fillStatus])
  @@index([activePersonId, fillStatus, activeValidFrom, activeValidTo], map: "ProjectPosition_activePerson_window_idx")
  @@index([fillStatus, priority, startDate])
  @@index([slaStage, slaDueAt])
  @@index([fillStatus, slaDueAt])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([requestedByPersonId])
  @@index([appliedRateCardEntryId])
  @@index([onboardingApprovedByPersonId], map: "ProjectPosition_onboardingApprovedByPerson_idx")
  @@index([legacyAssignmentId])
  @@index([legacyStaffingRequestId])
  @@map("ProjectPosition")
}

model ProjectPositionCandidate {
  id                  String                           @id @default(uuid()) @db.Uuid
  positionId          String                           @db.Uuid
  candidatePersonId   String                           @db.Uuid
  rank                Int
  matchScore          Decimal                          @db.Decimal(6, 3)
  availabilityPercent Decimal?                         @db.Decimal(5, 2)
  mismatchedSkills    String[]                         @default([])
  rationale           String?
  decision            ProjectPositionCandidateDecision @default(PENDING)
  decidedAt           DateTime?                        @db.Timestamptz(3)
  createdAt           DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                         @updatedAt @db.Timestamptz(3)
  createdByPersonId   String?                          @db.Uuid
  updatedByPersonId   String?                          @db.Uuid
  // LEAN-P0-5 — backfill provenance pointer at
  // StaffingRequestProposalCandidate.id. No @relation because the source
  // table drops in Phase 3; this is a soft pointer for forensic queries.
  legacyCandidateId   String?                          @db.Uuid
  position            ProjectPosition                  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate           Person                           @relation("ProjectPositionCandidatePerson", fields: [candidatePersonId], references: [id], onDelete: Restrict)
  createdByPerson     Person?                          @relation("ProjectPositionCandidateCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson     Person?                          @relation("ProjectPositionCandidateUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@unique([positionId, candidatePersonId])
  @@index([positionId, rank])
  @@index([candidatePersonId])
  @@index([positionId, decision])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([legacyCandidateId])
  @@map("ProjectPositionCandidate")
}

model ProjectPositionFillHistory {
  id                String                        @id @default(uuid()) @db.Uuid
  positionId        String                        @db.Uuid
  changeType        ProjectPositionFillChangeType
  changedByPersonId String?                       @db.Uuid
  changeReason      String?
  previousPersonId  String?                       @db.Uuid
  newPersonId       String?                       @db.Uuid
  previousStatus    ProjectPositionFillStatus?
  newStatus         ProjectPositionFillStatus?
  previousSnapshot  Json?
  newSnapshot       Json?
  occurredAt        DateTime                      @default(now()) @db.Timestamptz(3)
  position          ProjectPosition               @relation(fields: [positionId], references: [id], onDelete: Restrict)
  changedBy         Person?                       @relation("ProjectPositionFillHistoryChangedBy", fields: [changedByPersonId], references: [id], onDelete: NoAction)

  @@index([positionId, occurredAt])
  @@index([changedByPersonId])
  @@index([changeType])
  @@map("ProjectPositionFillHistory")
}

/// DomainEvent is a partitioned table with a BEFORE INSERT hash-chain trigger.
/// Writes go through raw SQL in src/modules/audit-observability/application/domain-event.service.ts.
model DomainEvent {
  id            String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType AggregateType
  aggregateId   String        @db.Uuid
  eventName     String
  actorId       String?       @db.Uuid
  correlationId String?
  causationId   String?       @db.Uuid
  payload       Json
  publishedAt   DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  prevHash      String?
  rowHash       String?
  chainSeq      BigInt        @default(autoincrement())
  tenantId      String?       @db.Uuid
  Tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([aggregateType, aggregateId], map: "DomainEvent_aggregate_idx")
  @@index([createdAt(sort: Desc)])
  @@index([eventName])
  @@index([tenantId])
  @@map("DomainEvent")
}

/// DM-8-10 — periodic capacity snapshot per audit table. Trigger-populated.
model capacity_audit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordedAt   DateTime @default(now()) @db.Timestamptz(6)
  tableName    String
  rowCount     BigInt
  relSizeBytes BigInt?
  notes        String?

  @@index([tableName, recordedAt(sort: Desc)], map: "capacity_audit_table_recorded_idx")
  @@map("capacity_audit")
}

/// DM-R-21 — every DDL statement is recorded by an event trigger. Hash-chained.
model ddl_audit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at     DateTime @default(now()) @db.Timestamptz(6)
  sessionUser     String
  currentUser     String
  applicationName String?
  commandTag      String
  objectType      String?
  objectIdentity  String?
  query           String?
  inFunction      String?
  prevHash        String?
  rowHash         String?
  chainSeq        BigInt   @default(autoincrement())

  @@index([occurred_at(sort: Desc)])
  @@index([sessionUser])
  @@map("ddl_audit")
}

/// DM-R-7 — every migrate run logs here. Hash-chained.
model migration_audit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recorded_at    DateTime @default(now()) @db.Timestamptz(6)
  migration_mode String
  migrations     String?
  os_user        String?
  git_email      String?
  git_sha        String?
  agent_id       String?
  hostname       String?
  success        Boolean
  notes          String?
  prevHash       String?
  rowHash        String?
  chainSeq       BigInt   @default(autoincrement())

  @@index([recorded_at(sort: Desc)])
  @@map("migration_audit")
}

/// DM-R-31 — honeypot canary rows. The dm_r_31_honeypot_guard trigger
/// raises an alert into honeypot_alerts on UPDATE/DELETE attempts.
model honeypot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableName String
  rowId     String   @db.Uuid
  intent    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tableName, rowId])
  @@map("honeypot")
}

model honeypot_alerts {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)
  tableName       String
  rowId           String   @db.Uuid
  operation       String
  sessionUser     String
  currentUser     String
  applicationName String?
  query           String?

  @@index([occurredAt(sort: Desc)])
  @@map("honeypot_alerts")
}
