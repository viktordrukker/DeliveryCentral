  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
  createdByPersonId     String?                     @db.Uuid
  updatedByPersonId     String?                     @db.Uuid
  archivedAt            DateTime?                   @db.Timestamptz(3)
  deletedAt             DateTime?                   @db.Timestamptz(3)
  projectManager        Person?                     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdByPerson       Person?                     @relation("ProjectCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson       Person?                     @relation("ProjectUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  deliveryManager       Person?                     @relation("DeliveryManager", fields: [deliveryManagerId], references: [id])
