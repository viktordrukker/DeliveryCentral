// HD-9 — Help Center MVP (J11). Four append-light tables back the
// in-app help surface: an article catalog, route-pinned tips, per-user
// feedback, and per-user onboarding-tour progress. Tour DEFINITIONS
// live in code (a tenant-overridable JSON catalog); only progress is
// row-shaped. Admin edit + onboarding-tour FE land in later HD-9 chunks.
model HelpArticle {
  id                String         @id @default(uuid()) @db.Uuid
  // Stable URL handle. Lower-snake-case, used in `/help/:slug`.
  slug              String         @unique
  title             String
  // Short blurb shown on the list view. Plain text only.
  summary           String
  // Full article body. Markdown — renderer is a later chunk.
  body              String
  // Flat-tag categorization. Power users can filter the list by tag.
  // Nested categories deferred to a future iteration.
  tags              String[]       @default([])
  isPublished       Boolean        @default(false)
  authorPersonId    String?        @db.Uuid
  author            Person?        @relation("HelpArticleAuthor", fields: [authorPersonId], references: [id], onDelete: SetNull)
  tenantId          String?        @db.Uuid
  Tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?      @db.Timestamptz(3)
  // F-46 / D-103 round 13 — actor-audit columns.
  createdByPersonId String?        @db.Uuid
  updatedByPersonId String?        @db.Uuid
  createdByPerson   Person?        @relation("HelpArticleCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?        @relation("HelpArticleUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  feedbacks         HelpFeedback[]
  tips              HelpTip[]

  @@index([isPublished, archivedAt])
  @@index([tenantId])
  @@index([authorPersonId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("help_articles")
}

// Route-pinned contextual tip. The frontend's `TipBalloon` component
// can be swapped from hard-coded strings to data-fed via these rows.
// `key` is the stable identifier the FE references (e.g.
// `staffing.desk.cell.dropzone`); `routePath` lets ops show only
// route-relevant tips on each page.
model HelpTip {
  id                String       @id @default(uuid()) @db.Uuid
  key               String       @unique
  routePath         String
  title             String
  body              String
  // Optional deep-link to a full article. NULL = standalone tip.
  articleId         String?      @db.Uuid
  article           HelpArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  displayOrder      Int          @default(100)
  isActive          Boolean      @default(true)
  tenantId          String?      @db.Uuid
  Tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?    @db.Timestamptz(3)
  // F-78 / D-103 + DM-5-5 round 29 — actor-audit columns.
  createdByPersonId String?      @db.Uuid
  updatedByPersonId String?      @db.Uuid
  createdByPerson   Person?      @relation("HelpTipCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?      @relation("HelpTipUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([routePath, isActive])
  @@index([articleId])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("help_tips")
}

// Reader feedback on an article. Multiple feedback rows per
// (article, actor) are allowed so a user can revise their take as the
// article improves; the FE shows the most recent one in admin views.
model HelpFeedback {
  id            String      @id @default(uuid()) @db.Uuid
  articleId     String      @db.Uuid
  article       HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actorPersonId String?     @db.Uuid
  actor         Person?     @relation("HelpFeedbackActor", fields: [actorPersonId], references: [id], onDelete: SetNull)
  wasHelpful    Boolean
  comment       String?
  tenantId      String?     @db.Uuid
  Tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([articleId, createdAt])
  @@index([actorPersonId])
  @@index([tenantId])
  @@map("help_feedback")
}

// Per-user progress through a named onboarding tour. The tour itself
// (its steps + their target routes) lives in code/seed; this row only
// captures which steps the user has completed for a given key.
//
// `dismissedAt` and `completedAt` are mutually exclusive in spirit but
// the schema doesn't enforce that — `dismissedAt` means the user
// clicked "skip", `completedAt` means they ran every step. The FE
// uses either as a "don't show this tour again" signal.
model OnboardingTourProgress {
  id                String    @id @default(uuid()) @db.Uuid
  // F-20 / D-109 — audit-adjacent analytics survive person deletion.
  // `onDelete: SetNull` keeps onboarding-effectiveness signals when
  // a person row is removed; the orphan rows are no longer queryable
  // by the (personId, tourKey) unique key but still feed retention
  // analytics.
  personId          String?   @db.Uuid
  person            Person?   @relation("OnboardingTourPerson", fields: [personId], references: [id], onDelete: SetNull)
  // Tour identifier. Stable, lowercase, kebab-case. e.g. `staffing-desk-101`.
  tourKey           String
  completedSteps    String[]  @default([])
  dismissedAt       DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  tenantId          String?   @db.Uuid
  Tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  // F-82 / D-103 + DM-5-5 round 31 — actor-audit columns.
  createdByPersonId String?   @db.Uuid
  updatedByPersonId String?   @db.Uuid
  createdByPerson   Person?   @relation("OnboardingTourProgressCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?   @relation("OnboardingTourProgressUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@unique([personId, tourKey])
  @@index([tourKey])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("onboarding_tour_progress")
}

// =============================================================================
// In-app first-run setup wizard
// =============================================================================

enum SetupRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum SetupRunLogLevel {
  TRACE
  DEBUG
  INFO
  WARN
  ERROR
}

model SetupRun {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId           String         @map("run_id") @db.Uuid
  stepKey         String         @map("step_key")
  status          SetupRunStatus @default(PENDING)
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  errorPayload    Json?          @map("error_payload")
  actorId         String?        @map("actor_id") @db.Uuid
  payloadRedacted Json?          @map("payload_redacted")
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([runId, stepKey])
  @@index([runId])
  @@index([status, startedAt])
  @@map("setup_runs")
}

model SetupRunLog {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId           String           @map("run_id") @db.Uuid
  stepKey         String           @map("step_key")
  sequence        Int
  level           SetupRunLogLevel @default(INFO)
  event           String
  payloadRedacted Json?            @map("payload_redacted")
  durationMs      Int?             @map("duration_ms")
  occurredAt      DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([runId, sequence])
  @@index([runId, stepKey])
  @@index([level, occurredAt])
  @@map("setup_run_logs")
}

// =============================================================================
// Skills Registry
// =============================================================================

model Skill {
  id                String        @id @default(uuid())
  idNew             String        @default(dbgenerated("gen_random_uuid()")) @map("id_new") @db.Uuid
  publicId          String?       @unique @db.VarChar(32)
  name              String        @unique
  category          String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  // F-66 / D-103 round 23 — adds `updatedAt` + actor-audit pair. Skill
  // was missing `updatedAt` entirely; the migration backfills via DEFAULT
  // NOW() so legacy rows take install-time as their first "update" stamp.
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  createdByPersonId String?       @db.Uuid
  updatedByPersonId String?       @db.Uuid
  createdByPerson   Person?       @relation("SkillCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?       @relation("SkillUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  personSkills      PersonSkill[]
  tenantId          String?       @db.Uuid
  Tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("skills")
}

model PersonSkill {
  id                     String    @id @default(uuid())
  idNew                  String    @default(dbgenerated("gen_random_uuid()")) @map("id_new") @db.Uuid
  personId               String    @db.Uuid
  person                 Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId                String
  skill                  Skill     @relation(fields: [skillId], references: [id])
  proficiency            Int
  certified              Boolean   @default(false)
  // FE-#263 — drives "certification_stale" HR action-cards. NULL = no expiry.
  certificationExpiresAt DateTime? @db.Date
  // LEAN-P4d-4 — TRUE when the employee added the row from /me/skills
  // (no HR review). HR dashboards surface this pool as "unverified".
  selfEndorsed           Boolean   @default(false)
  // LEAN-P4c-4 — manager-approval audit columns. NULL while the row is
  // still pending HR review; populated on the APPROVE path. A reject
  // deletes the row outright (no soft-delete flag).
  endorsedByPersonId     String?   @db.Uuid
  endorsedByPerson       Person?   @relation("PersonSkillEndorsedBy", fields: [endorsedByPersonId], references: [id], onDelete: SetNull)
  endorsedAt             DateTime? @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([personId, skillId])
  @@index([personId])
  @@index([skillId])
  @@index([endorsedByPersonId], map: "person_skills_endorsedByPerson_idx")
  @@map("person_skills")
}

enum LeaveRequestType {
  ANNUAL
  SICK
  PARENTAL
  COMPASSIONATE
  UNPAID
  OTHER
  OT_OFF
  PERSONAL
  BEREAVEMENT
  STUDY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id                String             @id @default(uuid())
  idNew             String             @default(dbgenerated("gen_random_uuid()")) @map("id_new") @db.Uuid
  publicId          String?            @unique @db.VarChar(32)
  personId          String
  type              LeaveRequestType
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  notes             String?
  status            LeaveRequestStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?          @db.Timestamptz(3)
  // Track B.1 — reviewer's free-text justification on approve / reject. The
  // manager Leave Decision Drawer surfaces this in the audit trail; NULL
  // when the reviewer left it blank.
  reviewComment     String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  // F-26 / D-103 + DM-5-5 round 3 — actor-audit columns. The
  // legacy `reviewedBy` column captures who approved/rejected; these
  // capture who created the leave request (potentially != `personId`
  // when HR creates on behalf) and who last modified it.
  createdByPersonId String?            @db.Uuid
  updatedByPersonId String?            @db.Uuid
  version           Int                @default(1)
  tenantId          String?            @db.Uuid
  Tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByPerson   Person?            @relation("LeaveRequestCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?            @relation("LeaveRequestUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([personId, status])
  @@index([status])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("leave_requests")
}

// =============================================================================
// Overtime — policies, exceptions
// =============================================================================

model OvertimePolicy {
  id                      String    @id @default(uuid()) @db.Uuid
  orgUnitId               String?   @db.Uuid
  resourcePoolId          String?   @db.Uuid
  standardHoursPerWeek    Int
  maxOvertimeHoursPerWeek Int
  setByPersonId           String    @db.Uuid
  approvalCaseId          String?   @db.Uuid
  approvalStatus          String    @default("ACTIVE") // ACTIVE, PENDING_APPROVAL, REJECTED
  effectiveFrom           DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo             DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  // F-40 / D-103 + DM-5-5 round 10 — actor-audit columns. `setByPersonId`
  // is the business actor; these capture the row author (often == setBy)
  // and last editor for uniform join-by-actor queries.
  createdByPersonId       String?   @db.Uuid
  updatedByPersonId       String?   @db.Uuid

  orgUnit         OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  resourcePool    ResourcePool? @relation(fields: [resourcePoolId], references: [id])
  setBy           Person        @relation("OvertimePolicySetBy", fields: [setByPersonId], references: [id])
  approvalCase    CaseRecord?   @relation("OvertimePolicyApprovalCase", fields: [approvalCaseId], references: [id], onDelete: SetNull)
  createdByPerson Person?       @relation("OvertimePolicyCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson Person?       @relation("OvertimePolicyUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([orgUnitId, effectiveFrom])
  @@index([resourcePoolId, effectiveFrom])
  @@index([approvalCaseId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([setByPersonId])
  @@map("overtime_policies")
}

model OvertimeException {
  id                      String   @id @default(uuid()) @db.Uuid
  personId                String   @db.Uuid
  caseRecordId            String   @db.Uuid
  maxOvertimeHoursPerWeek Int
  reason                  String
  effectiveFrom           DateTime @db.Timestamptz(3)
  effectiveTo             DateTime @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  // F-56 / D-103 round 18 — actor-audit columns.
  createdByPersonId       String?  @db.Uuid
  updatedByPersonId       String?  @db.Uuid
  createdByPerson         Person?  @relation("OvertimeExceptionCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson         Person?  @relation("OvertimeExceptionUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  person     Person     @relation(fields: [personId], references: [id])
  caseRecord CaseRecord @relation(fields: [caseRecordId], references: [id])

  @@index([personId, effectiveFrom, effectiveTo])
  @@index([caseRecordId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("overtime_exceptions")
}

// =============================================================================
// Leave Balances & Public Holidays
// =============================================================================

model LeaveBalance {
  id                String           @id @default(uuid()) @db.Uuid
  personId          String           @db.Uuid
  year              Int
  leaveType         LeaveRequestType
  entitlement       Decimal          @db.Decimal(5, 1)
  used              Decimal          @default(0) @db.Decimal(5, 1)
  pending           Decimal          @default(0) @db.Decimal(5, 1)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  // F-52 / D-103 round 16 — actor-audit columns.
  createdByPersonId String?          @db.Uuid
  updatedByPersonId String?          @db.Uuid
  createdByPerson   Person?          @relation("LeaveBalanceCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?          @relation("LeaveBalanceUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, year, leaveType])
  @@index([personId, year])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("leave_balances")
}

// LEAN-P4-missing-13 — admin-managed leave policies.
//
// Replaces hard-coded constants (default entitlement, max carry-over,
// approval chain) so tenant admins can tune leave behaviour from
// /admin without code changes. The set of leave types lives on the
// `LeaveRequestType` enum; one active policy per leaveType is the
// invariant the service layer enforces.
model LeavePolicy {
  id                String           @id @default(uuid()) @db.Uuid
  publicId          String?          @unique @db.VarChar(32)
  name              String
  leaveType         LeaveRequestType
  accrualPerYear    Int
  maxCarryOver      Int
  approvalChain     String[]
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  createdByPersonId String?          @db.Uuid
  updatedByPersonId String?          @db.Uuid
  createdByPerson   Person?          @relation("LeavePolicyCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?          @relation("LeavePolicyUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([leaveType, active])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("leave_policies")
}

// NEW-LGL-3 — tenant-defined custom roles. Bank ops add shapes like
// "Squad Lead", "Tribe Lead", "IT Service Owner" without code changes.
// Built-in PlatformRole values (admin, director, hr_manager, …) are NOT
// represented as rows; they remain compile-time constants. Custom roles
// carry a slug key, a display name, and a list of inherited PlatformRole
// values that propagate their effective permissions through the existing
// @RequireRoles guard. Soft-delete via `deactivatedAt`. `isBuiltIn` is
// reserved for any future seed presets surfaced as rows.
model CustomRole {
  id                String    @id @default(uuid()) @db.Uuid
  publicId          String?   @unique @db.VarChar(32)
  roleKey           String    @unique @db.VarChar(64)
  displayName       String    @db.VarChar(120)
  description       String?
  inheritedRoles    String[]
  isBuiltIn         Boolean   @default(false)
  deactivatedAt     DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  createdByPersonId String?   @db.Uuid
  updatedByPersonId String?   @db.Uuid
  createdByPerson   Person?   @relation("CustomRoleCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?   @relation("CustomRoleUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([deactivatedAt])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("custom_roles")
}

model PublicHoliday {
  id                String   @id @default(uuid()) @db.Uuid
  date              DateTime @db.Date
  name              String
  // F-7.2 / D-163 — region code (country or sub-region like 'US-CA').
  // Default removed so multi-region tenants explicitly tag every row.
  // Existing AU rows continue to work; new rows must specify.
  countryCode       String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  // F-87 / D-103 + DM-5-5 round 36 — createdByPersonId only (immutable row).
  createdByPersonId String?  @db.Uuid
  createdByPerson   Person?  @relation("PublicHolidayCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  @@unique([date, countryCode])
  @@index([countryCode, date])
  @@index([createdByPersonId])
  @@map("public_holidays")
}

// ── Client & Vendor (Phase 1) ─────────────────────────────────────────────────

// D-112 — Class E pattern (Client, Tenant, Vendor): `isActive Boolean`
// only, NO `archivedAt`. Intentional. These tables are reference data
// where "this entity is no longer transacting" is the only state we
// care about; historical assignments / projects retain their FK
// reference and continue to display the entity's name. We don't need
// audit-trail timestamps on disable because the change is captured by
// the AuditLog hash chain. If future analytics ever need historical
// inactivity windows, migrate to `archivedAt` + an additional
// `inactiveAt`; not needed today.

model Client {
  id                     String     @id @default(uuid()) @db.Uuid
  publicId               String?    @unique @db.VarChar(32)
  name                   String     @unique
  industry               String?
  accountManagerPersonId String?    @db.Uuid
  notes                  String?
  isActive               Boolean    @default(true)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)
  // F-42 / D-103 + DM-5-5 round 11 — actor-audit columns.
  // `accountManagerPersonId` is the business actor; these capture
  // the row author + last editor.
  createdByPersonId      String?    @db.Uuid
  updatedByPersonId      String?    @db.Uuid
  accountManager         Person?    @relation("ClientAccountManager", fields: [accountManagerPersonId], references: [id])
  projects               Project[]
  rateCards              RateCard[]
  tenantId               String?    @db.Uuid
  Tenant                 Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByPerson        Person?    @relation("ClientCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson        Person?    @relation("ClientUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([accountManagerPersonId])
  @@map("clients")
}

model Vendor {
  id                String                    @id @default(uuid()) @db.Uuid
  name              String                    @unique
  contactName       String?
  contactEmail      String?
  contractType      VendorContractType        @default(STAFF_AUGMENTATION)
  skillAreas        String[]                  @default([])
  notes             String?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  // F-42 / D-103 + DM-5-5 round 11 — actor-audit columns.
  createdByPersonId String?                   @db.Uuid
  updatedByPersonId String?                   @db.Uuid
  engagements       ProjectVendorEngagement[]
  skillAreasList    VendorSkillArea[]
  tenantId          String?                   @db.Uuid
  Tenant            Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByPerson   Person?                   @relation("VendorCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?                   @relation("VendorUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("vendors")
}

model ProjectVendorEngagement {
  id                String                 @id @default(uuid()) @db.Uuid
  projectId         String                 @db.Uuid
  vendorId          String                 @db.Uuid
  roleSummary       String
  headcount         Int                    @default(1)
  monthlyRate       Decimal?               @db.Decimal(12, 2)
  blendedDayRate    Decimal?               @db.Decimal(10, 2)
  currencyCode      String?                @db.VarChar(3)
  currency          Currency?              @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  startDate         DateTime?              @db.Timestamptz(3)
  endDate           DateTime?              @db.Timestamptz(3)
  status            VendorEngagementStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  // F-46 / D-103 round 13 — actor-audit columns.
  createdByPersonId String?                @db.Uuid
  updatedByPersonId String?                @db.Uuid
  createdByPerson   Person?                @relation("ProjectVendorEngagementCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?                @relation("ProjectVendorEngagementUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  project           Project                @relation(fields: [projectId], references: [id])
  vendor            Vendor                 @relation(fields: [vendorId], references: [id])

  @@unique([projectId, vendorId])
  @@index([projectId, status])
  @@index([vendorId])
  @@index([currencyCode])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("project_vendor_engagements")
}

// ── Role Plan (Phase 2) ───────────────────────────────────────────────────────

model ProjectRolePlan {
