// =====================================================================
// DM-7 multi-tenant + DM-R-22 hash-chain audit / DM-R-31 honeypot canaries
//
// These tables exist in the database but are NOT consumed via the Prisma
// Client. Tenant + DomainEvent are written by raw SQL in
// `setup.service.ts` and `domain-event.service.ts`. capacity_audit /
// ddl_audit / migration_audit / honeypot / honeypot_alerts are populated
// by Postgres triggers (DM-R-21, DM-R-22, DM-R-31, DM-8-10).
//
// They are declared here only so `prisma migrate diff --exit-code`
// recognises them as part of the schema. Application code MUST NOT use
// `prisma.tenant.*` / `prisma.domainEvent.*` etc. — RLS, partitioning,
// triggers, and the DM-R-22 hash chain make Prisma Client unsafe.
// =====================================================================

enum AggregateType {
  Person
  Tenant
  Project
  Client
  Vendor
  OrgUnit
  ResourcePool
  CaseRecord
  TimesheetWeek
  LeaveRequest
  Notification
  DomainEvent
  Skill
  PeriodLock
  PersonCostRate
  ProjectBudget
  ProjectRisk
  ProjectRagSnapshot
  ProjectChangeRequest
  ProjectMilestone
  ProjectRadiatorOverride
  EmploymentEvent
  Contact
  BudgetApproval
  Migration
  // Sprint 2 / S2-7 — lean staffing aggregate (S2-1).
  ProjectPosition
}

model Tenant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String    @unique
  name              String
  isActive          Boolean   @default(true)
  suspendedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(6)
  // F-85 / D-103 + DM-5-5 round 34 — actor-audit columns.
  createdByPersonId String?   @db.Uuid
  updatedByPersonId String?   @db.Uuid
  createdByPerson   Person?   @relation("TenantCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?   @relation("TenantUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  AuditLog                  AuditLog[]
  CaseRecord                CaseRecord[]
  DomainEvent               DomainEvent[]
  LocalAccount              LocalAccount[]
  OrgUnit                   OrgUnit[]
  OutboxEvent               OutboxEvent[]
  Person                    Person[]
