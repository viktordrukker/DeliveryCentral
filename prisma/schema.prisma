// HD-3 — Bill-rate resolution (J2). A `RateCard` is a tenant-scoped or
// client-scoped collection of `RateCardEntry` rows; each entry maps a
// (role, grade, optional required skills) tuple to an hourly bill
// rate. The resolver walks 5 layers of precedence at assignment-book
// time and pins the chosen entry on `ProjectAssignment.appliedRateCardEntryId`
// so margin math has a stable reference.
model RateCard {
  id                String          @id @default(uuid()) @db.Uuid
  // Stable, human-readable handle. Used in admin UIs + pinned audit refs.
  name              String
  // Three-letter ISO currency code; rate values are interpreted in this currency.
  currencyCode      String          @db.VarChar(3)
  currency          Currency        @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  // Scope. A card targets either a specific client OR is the tenant default (clientId NULL).
  // The resolver checks client-scoped cards before falling back to tenant default.
  clientId          String?         @db.Uuid
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Activation window. The resolver only considers cards whose [validFrom, validTo]
  // covers the assignment's `validFrom`. NULL `validTo` = open-ended.
  validFrom         DateTime        @db.Date
  validTo           DateTime?       @db.Date
  // D-113 — Class F state machine (`isActive` + `archivedAt`). On RateCard
  // specifically (financial), the combinations have to be read carefully:
  //   • isActive=true,  archivedAt=null  → live, eligible for resolver pick
  //   • isActive=false, archivedAt=null  → disabled by admin, no new picks,
  //                                        but `appliedRateCardEntryId` refs
  //                                        on existing assignments stay valid
  //                                        (rate-pinning preserved)
  //   • isActive=*,     archivedAt!=null → soft-deleted; admin UI hides it
  //                                        but historical assignments still
  //                                        resolve their pinned entry
  // Drift between isActive and archivedAt is fine because the resolver uses
  // isActive only; archivedAt is the visibility filter for admin UIs.
  isActive          Boolean         @default(true)
  notes             String?
  tenantId          String?         @db.Uuid
  Tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?       @db.Timestamptz(3)
  // F-36 / D-103 + DM-5-5 round 8 — actor-audit columns. RateCard is
  // admin-curated and drives margin math; on-row creator/editor
  // tracking is finance-grade.
  createdByPersonId String?         @db.Uuid
  updatedByPersonId String?         @db.Uuid
  entries           RateCardEntry[]
  createdByPerson   Person?         @relation("RateCardCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?         @relation("RateCardUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([clientId, isActive])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([currencyCode])
  @@map("rate_cards")
}

model RateCardEntry {
  id                      String            @id @default(uuid()) @db.Uuid
  rateCardId              String            @db.Uuid
  rateCard                RateCard          @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  // Match keys. `staffingRole` is required, `grade` is required (matches
  // tenant `MetadataDictionary{key:'grade'}` per J8), `requiredSkills`
  // is an optional positive-match list — the assignment's person must
  // hold ALL listed skills for the entry to apply.
  staffingRole            String
  grade                   String
  requiredSkills          String[]          @default([])
  // Hourly bill rate in the parent card's currency.
  hourlyRate              Decimal           @db.Decimal(10, 2)
  notes                   String?
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt              DateTime?         @db.Timestamptz(3)
  // F-52 / D-103 round 16 — actor-audit columns.
  createdByPersonId       String?           @db.Uuid
  updatedByPersonId       String?           @db.Uuid
  createdByPerson         Person?           @relation("RateCardEntryCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson         Person?           @relation("RateCardEntryUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  // Sprint 2 / S2-1 — lean staffing aggregate.
  pinnedPositionRelations ProjectPosition[] @relation("ProjectPositionRateCardEntry")
  // LEAN-P3-1 — provenance snapshot JSONB of the pinned positions at
  // Phase 3 fixup time (assignmentId/positionId/role/hourlyRate triplets).
  // See prisma/migrations/20260606_lean_p3_1_data_fixup/migration.sql.
  pinnedPositions         Json              @default("[]") @db.JsonB

  @@unique([rateCardId, staffingRole, grade])
  @@index([rateCardId, isActive])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("rate_card_entries")
}

