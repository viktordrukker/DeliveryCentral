// HD-0.4 — Idempotency key store. Front-door cache for write requests
// that opt in via the `Idempotency-Key` HTTP header. The interceptor
// looks up `(key, method, path, actorId)` on entry; cached COMPLETED
// rows replay the stored response, PENDING rows return 409 (concurrent
// duplicate), and a fresh write reserves the row before running the
// handler then stamps the response payload on success.
model IdempotencyKey {
  id             String               @id @default(uuid()) @db.Uuid
  // The header value. Caller-supplied, treated as opaque.
  idempotencyKey String               @map("idempotency_key")
  method         String
  path           String
  actorId        String?              @map("actor_id") @db.Uuid
  // Cryptographic hash of the request body so a same-key + different-body
  // attempt can be rejected explicitly rather than silently replaying
  // the wrong response.
  requestHash    String               @map("request_hash")
  status         IdempotencyKeyStatus @default(PENDING)
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(3)
  // Rows expire 24h after creation; a sweep job (future work) prunes
  // them. The interceptor treats expired rows as absent.
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)

  @@unique([idempotencyKey, method, path, actorId], map: "uq_idempotency_key_actor_route")
  @@index([expiresAt], map: "idx_idempotency_key_expires_at")
  @@map("idempotency_keys")
}

