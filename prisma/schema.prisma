// ── RAG Snapshots (Phase 3) ───────────────────────────────────────────────────

model ProjectRagSnapshot {
  id                  String                    @id @default(uuid()) @db.Uuid
  projectId           String                    @db.Uuid
  weekStarting        DateTime                  @db.Date
  staffingRag         RagRating
  scheduleRag         RagRating
  budgetRag           RagRating
  clientRag           RagRating?
  scopeRag            RagRating?
  peopleRag           RagRating?
  overallRag          RagRating
  autoComputedOverall RagRating?
  isOverridden        Boolean                   @default(false)
  overrideReason      String?
  narrative           String?
  accomplishments     String?
  nextSteps           String?
  dimensionDetails    Json?
  riskSummary         String?
  scopeScore          Int?
  scheduleScore       Int?
  budgetScore         Int?
  peopleScore         Int?
  overallScore        Int?
  recordedByPersonId  String                    @db.Uuid
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  // F-83 / D-103 + DM-5-5 round 32 — actor-audit columns. Distinct from
  // `recordedByPersonId` (the recorder semantic); these track row mutations.
  createdByPersonId   String?                   @db.Uuid
  updatedByPersonId   String?                   @db.Uuid
