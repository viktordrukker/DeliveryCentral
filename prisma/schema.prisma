/// DM-6a-1 — ISO 4217 currency dictionary. Every monetary column
/// (ProjectBudget.capexBudget/opexBudget, PersonCostRate.hourlyRate,
/// ProjectVendorEngagement.monthlyRate/blendedDayRate) references a
/// currency code here. The dev default is AUD; multi-tenant deploys
/// override via `isDefault`. Minor units drive display precision.
model Currency {
  code              String   @id @db.VarChar(3)
  name              String
  minorUnit         Int      @default(2)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  // F-87 / D-103 + DM-5-5 round 36 — createdByPersonId only (admin seeded).
  createdByPersonId String?  @db.Uuid

  projectBudgets           ProjectBudget[]
  personCostRates          PersonCostRate[]
  projectVendorEngagements ProjectVendorEngagement[]
  rateCards                RateCard[]
  fxRatesFrom              FxRate[]                  @relation("FxRateFromCurrency")
  fxRatesTo                FxRate[]                  @relation("FxRateToCurrency")
  createdByPerson          Person?                   @relation("CurrencyCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  @@index([createdByPersonId])
  @@map("Currency")
}

/// F-7.4 / D-164 — multi-currency consolidation backing table.
///
/// One row per `(fromCurrency, toCurrency, asOf)` triple. `rate` is the
/// multiplier: amount-in-from × rate = amount-in-to. Higher precision
/// than money (8 fractional digits) so a long-running consolidation
/// over multi-year history doesn't accumulate rounding error.
///
/// Lookup pattern: get the most recent row where `asOf <= today` for
/// the (from, to) pair. `FxRateService.getLatestRate` implements that.
/// Same-currency conversions short-circuit to `rate = 1`.
///
/// Gated by `flag.feature.financial.multiCurrency.enabled` — the
/// table exists in v1 so the schema is portable, but the
/// `FinancialService` only consults it when the flag is ON.
model FxRate {
  id                String   @id @default(uuid()) @db.Uuid
  fromCurrency      String   @db.VarChar(3)
  toCurrency        String   @db.VarChar(3)
  rate              Decimal  @db.Decimal(18, 8)
  asOf              DateTime @db.Date
  source            String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  // F-87 / D-103 + DM-5-5 round 36 — createdByPersonId only (immutable row).
  createdByPersonId String?  @db.Uuid

  from            Currency @relation("FxRateFromCurrency", fields: [fromCurrency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  to              Currency @relation("FxRateToCurrency", fields: [toCurrency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  createdByPerson Person?  @relation("FxRateCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  @@unique([fromCurrency, toCurrency, asOf])
  @@index([fromCurrency, toCurrency, asOf(sort: Desc)])
  @@index([toCurrency])
  @@index([createdByPersonId])
  @@map("fx_rates")
}

/// F-7.5 / D-160b — Fiscal Calendar entity.
///
/// One row per tenant fiscal year (e.g. "FY2026 GB" = Apr 1 2026 – Mar 31
/// 2027). Each calendar has 12 FiscalPeriod rows (monthly), grouped into
/// quarters 1–4. Replaces the D-160a "single fiscalYearStart number"
/// quick fix with a real entity so quarterly/period rollups can be
/// driven from real data rather than computed every read.
///
/// Gated by `flag.feature.financial.fiscalCalendar.entity.enabled`
/// (default OFF). Until flipped, financial-report consumers stick with
/// the simpler D-160a path (`general.fiscalYearStart` setting).
model FiscalCalendar {
  id                String   @id @default(uuid()) @db.Uuid
  /// Tenant-chosen handle, e.g. `FY2026` or `FY2026-GB`. Stable across
  /// admin edits so reports can pin to a name.
  name              String   @unique
  /// Fiscal year number (e.g. 2026). Matches `ProjectBudget.fiscalYear`.
  fiscalYear        Int
  /// First day of the FY (inclusive).
  startDate         DateTime @db.Date
  /// Last day of the FY (inclusive).
  endDate           DateTime @db.Date
  /// Optional tag for multi-region tenants ("GB", "US", etc.). NULL
  /// means tenant-wide / default calendar.
  regionCode        String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  // F-84 / D-103 + DM-5-5 round 33 — actor-audit columns.
  createdByPersonId String?  @db.Uuid
  updatedByPersonId String?  @db.Uuid

  periods         FiscalPeriod[]
  createdByPerson Person?        @relation("FiscalCalendarCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson Person?        @relation("FiscalCalendarUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@unique([fiscalYear, regionCode])
  @@index([startDate, endDate])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("fiscal_calendars")
}

/// One monthly period within a FiscalCalendar. Quarters are derived
/// from `quarter` (1–4). All periods are bounded by the parent
/// calendar's [startDate, endDate].
model FiscalPeriod {
  id                String         @id @default(uuid()) @db.Uuid
  calendarId        String         @db.Uuid
  calendar          FiscalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// 1–12 monthly period number within the fiscal year.
  periodNumber      Int
  /// 1–4 quarter number within the fiscal year.
  quarter           Int
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  /// Short label, e.g. "Apr 2026" or "P1". Display-only.
  label             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  // F-88 / D-103 + DM-5-5 round 37 — createdByPersonId only (immutable row).
  createdByPersonId String?        @db.Uuid
  createdByPerson   Person?        @relation("FiscalPeriodCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  @@unique([calendarId, periodNumber])
  @@index([calendarId, startDate])
  @@index([createdByPersonId])
  @@map("fiscal_periods")
}

