// HD-4 — ResponsibilityRule enums (J4).
//
// 7 actions covering everything currently hardcoded in HD-2/HD-5/HD-6
// plus the assignment-side gates that were already wired before HD.
enum ResponsibilityActionKind {
  PROJECT_ACTIVATION_APPROVAL
  BUDGET_CHANGE_APPROVAL
  ASSIGNMENT_DIRECTOR_APPROVAL
  ASSIGNMENT_OVERRIDE_APPROVAL
  PERSON_RELEASE_HR_APPROVAL
  PERSON_RELEASE_DIRECTOR_APPROVAL
  PROJECT_CLOSE_APPROVAL
}

// 7 scopes — TENANT is the catch-all, the others narrow rules down.
// `scopeValue` semantics depend on the scope:
//   TENANT           — NULL
//   ORG_UNIT         — orgUnit.id (UUID)
//   CLIENT           — client.id (UUID)
//   PROJECT          — project.id (UUID)
//   PROJECT_TYPE     — engagementModel string ('TIME_AND_MATERIAL', …)
//   THRESHOLD_AMOUNT — numeric stringified currency value (the rule
//                      fires when the action's amount is ≥ scopeValue)
//   ROLE_GRADE       — grade dictionary key (e.g. 'g13')
enum ResponsibilityScope {
  TENANT
  ORG_UNIT
  CLIENT
  PROJECT
  PROJECT_TYPE
  THRESHOLD_AMOUNT
  ROLE_GRADE
}

// 4 resolution modes — see ResponsibilityRule model docstring.
enum ResponsibilityResolutionMode {
  ROLE
  PERSON
  PM_SOLO
  SKIP
}

// HD-5 — Per J3 the release flow is dual-approval: RM initiates,
// HR Manager AND Director both approve, then RM finalizes (cascade
// ends assignments + sets Person.terminatedAt). The request and its
// approvals live in two paired tables to keep the audit trail clean.
enum PersonReleaseStatus {
  PENDING_APPROVAL // request open, awaiting HR + Director approvals
  APPROVED // both approvals captured; awaiting RM finalize
  REJECTED // either HR or Director rejected
  CANCELLED // RM withdrew the request
  COMPLETED // RM finalized; Person terminated, assignments cancelled
}

enum ReleaseApprovalDecision {
  APPROVED
  REJECTED
}

model ProjectActivationApproval {
  id                String                     @id @default(uuid()) @db.Uuid
  projectId         String                     @db.Uuid
  requestedAt       DateTime                   @default(now()) @db.Timestamptz(3)
  requestedById     String                     @db.Uuid
  decidedAt         DateTime?                  @db.Timestamptz(3)
  decidedById       String?                    @db.Uuid
  decision          ProjectActivationDecision?
  reason            String?
  // F-21 / D-104 — framework-time timestamps standardised across
  // registry aggregates; business-time stays in requestedAt/decidedAt.
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  // F-44 / D-103 + DM-5-5 round 12 — actor-audit columns. The
  // existing `requestedById` and `decidedById` are business actors;
  // these mirror the canonical framework-time pair.
  createdByPersonId String?                    @db.Uuid
  updatedByPersonId String?                    @db.Uuid
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy       Person                     @relation("ProjectActivationApproval_requestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedBy         Person?                    @relation("ProjectActivationApproval_decidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenantId          String?                    @db.Uuid
  Tenant            Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByPerson   Person?                    @relation("ProjectActivationApprovalCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?                    @relation("ProjectActivationApprovalUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([projectId, requestedAt])
  @@index([decidedAt])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([requestedById])
  @@index([decidedById])
  @@map("project_activation_approvals")
}

// HD-4 — ResponsibilityRule (J4). A configurable matrix that decides
// "who is responsible for action X in scope Y". The resolver walks rules
// in priority order and returns the first match's `mode + target`.
//
// `actionKind` is what the caller is doing (PROJECT_ACTIVATION_APPROVAL,
// BUDGET_CHANGE_APPROVAL, …). `scopeKind` is the dimension being matched
// (TENANT default, ORG_UNIT, CLIENT, PROJECT, PROJECT_TYPE,
// THRESHOLD_AMOUNT, ROLE_GRADE). `mode` is how the resolver should turn
// the rule into a list of approvers:
//   ROLE      — anyone with `targetRole` in the principal claim.
//   PERSON    — exactly `targetPersonId`.
//   PM_SOLO   — the project's PM acts alone (no separate approver).
//   SKIP      — approval is NOT required at all in this scope.
model ResponsibilityRule {
  id                String                       @id @default(uuid()) @db.Uuid
  // What action this rule governs.
  actionKind        ResponsibilityActionKind
  // Dimension being matched. The resolver picks rules that satisfy the
  // caller's context (e.g. `scopeKind=ORG_UNIT, scopeValue=<unitId>`).
  scopeKind         ResponsibilityScope
  // Opaque value tied to `scopeKind`. UUID for ORG_UNIT/CLIENT/PROJECT;
  // numeric stringified threshold for THRESHOLD_AMOUNT; string for
  // PROJECT_TYPE/ROLE_GRADE; NULL for TENANT (the catch-all).
  scopeValue        String?
  // Resolution mode, see model docstring.
  mode              ResponsibilityResolutionMode
  // Populated when `mode='ROLE'`. Must match a value in
  // `frontend/src/app/route-manifest.ts` PLATFORM_ROLES.
  targetRole        String?
  // Populated when `mode='PERSON'`. Stable point-of-contact assignment.
  targetPersonId    String?                      @db.Uuid
  targetPerson      Person?                      @relation("ResponsibilityRuleTargetPerson", fields: [targetPersonId], references: [id], onDelete: SetNull)
  // Lower number = higher priority. The resolver returns the first
  // `isActive=true` rule per `(actionKind, scopeKind)`. Default 100;
  // tenants override with overrides at 1..99.
  priority          Int                          @default(100)
  isActive          Boolean                      @default(true)
  notes             String?
  tenantId          String?                      @db.Uuid
  Tenant            Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?                    @db.Timestamptz(3)
  // F-38 / D-103 + DM-5-5 round 9 — actor-audit columns. `targetPersonId`
  // is the rule's TARGET (PERSON mode); these capture who created/edited
  // the rule itself.
  createdByPersonId String?                      @db.Uuid
  updatedByPersonId String?                      @db.Uuid
  createdByPerson   Person?                      @relation("ResponsibilityRuleCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  updatedByPerson   Person?                      @relation("ResponsibilityRuleUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@index([actionKind, scopeKind, isActive, priority])
  @@index([targetPersonId])
  @@index([tenantId])
  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@map("responsibility_rules")
}

