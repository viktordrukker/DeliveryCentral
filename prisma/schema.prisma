  horizonFrom        DateTime?             @db.Date
  horizonWeeks       Int?

  createdBy Person  @relation("PlannerScenarioCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  updatedBy Person? @relation("PlannerScenarioUpdater", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  tenant    Tenant? @relation("PlannerScenarioTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([createdByPersonId])
  @@index([updatedByPersonId])
  @@index([archivedAt])
  @@index([tenantId, status])
  @@map("planner_scenarios")
}

enum PlannerScenarioStatus {
  DRAFT
  SUBMITTED
  APPLIED
  CANCELLED
}

// LEAN-P4-missing-9 — DM rejection escalation surface.
//
// When a Delivery Manager rejects a downstream artefact (timesheet variance,
// work-hour overrun, milestone slip, leave outside policy), the rejection
// escalates to a Director for confirmation or override:
//   * PENDING   — created by the DM, awaiting Director triage.
//   * CONFIRMED — Director endorsed the rejection; rejection stands.
//   * OVERRIDDEN — Director reversed the rejection; DM must re-approve.
//   * CANCELLED — DM withdrew the escalation before Director action.
//
// `sourceKind` + `sourceId` form an opaque pointer to the artefact; we do
// NOT model FKs here because the upstream surfaces (timesheets, work-hours,
// milestones) are heterogeneous. Aggregate prefix `dme` on publicId.
model DmEscalation {
  id                  String             @id @default(uuid()) @db.Uuid
  publicId            String?            @unique @db.VarChar(32)
  sourceKind          String
  sourceId            String             @db.Uuid
  escalatedByPersonId String             @db.Uuid
  escalatedToPersonId String?            @db.Uuid
  reason              String
  status              DmEscalationStatus @default(PENDING)
  resolvedAt          DateTime?          @db.Timestamptz(3)
  resolvedByPersonId  String?            @db.Uuid
  resolutionNotes     String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  escalatedBy Person  @relation("DmEscalationEscalatedBy", fields: [escalatedByPersonId], references: [id], onDelete: Restrict)
  escalatedTo Person? @relation("DmEscalationEscalatedTo", fields: [escalatedToPersonId], references: [id], onDelete: SetNull)
  resolvedBy  Person? @relation("DmEscalationResolvedBy", fields: [resolvedByPersonId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([escalatedByPersonId, status])
  @@index([escalatedToPersonId, status])
  @@index([resolvedByPersonId])
  @@map("dm_escalations")
}

enum DmEscalationStatus {
  PENDING
  CONFIRMED
  OVERRIDDEN
  CANCELLED
}

// Phase 21-07 — server-side notification preferences (one row per person × channel)
